{
  "name": "js-mcq",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "admin",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,admin,backend -c blue,magenta,green \"npm:dev:client\" \"npm:dev:admin\" \"npm:dev:backend\"",
    "dev:client": "npm run dev --workspace client",
    "dev:admin": "npm run dev --workspace admin",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace client && npm run build --workspace admin",
    "lint": "npm run lint --workspace client",
    "create-admin": "npm run create-admin --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
